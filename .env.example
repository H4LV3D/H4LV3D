# Public URL used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://toluwalope.tech

# Contact form (Resend — https://resend.com). Without these the form tells
# visitors to email you directly instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Portfolio <hello@toluwalope.tech>"
CONTACT_FROM_EMAIL=
# Where messages are delivered (defaults to the email in src/config/site.ts).
CONTACT_TO_EMAIL=
